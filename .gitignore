# dependencies
node_modules/
.pnp
.pnp.*

# next.js
# Anchored to the repo root on purpose: a bare "out/" or "build/" matches a
# directory of that name at ANY depth, which silently swallowed the whole
# app/(app)/warehouse/out route — it was committed, pushed and reported as
# shipped while never actually reaching the repo.
/.next/
/out/
/build/

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env*.local
.env

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# local scratch / temp files (never commit)
.tmp-*
*.tmp.*
deploy*.log
.claude-dev.cmd
ONBOARDING.md
